          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Response status is 201 Created\", function() {\r\n    pm.response.to.have.status(201);\r\n})\r\nconst json = pm.response.json();\r\npm.test(\"Response body contains the correct library card details\", function () {\r\n    pm.expect(json.ownerId).to.eql(pm.environment.get(\"createdUserId\"));\r\n    pm.expect(json.email).to.eql(\"john.doe@gmail.com\");\r\n    pm.expect(json.postcode).to.eql(\"010101\");\r\n    pm.expect(json.birthYear).to.eql(\"2000\");\r\n    pm.expect(json.livingAddress).to.eql(\"Joshing Around Ave., Brighton\");\r\n    pm.expect(json.workOrStudyAddress).to.eql(\"Serious Mode Blvd., Brighton\");\r\n    pm.expect(json.organisation).to.eql(\"Serious Factory\");\r\n    pm.expect(json.workPosition).to.eql(\"Serious Manufacturer\");\r\n})\r\npm.test(\"Location header is present\", function () {\r\n    pm.response.to.have.header(\"Location\");\r\n    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/library-card\");\r\n})"
