    {
      "name": "Create a new user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Response status is 201 Created\", function() {\r\n    pm.response.to.have.status(201);\r\n})\r\nconst json = pm.response.json();\r\npm.test(\"Response body contains the correct user details\", function () {\r\n    pm.expect(json.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$/i);\r\n    pm.expect(json.name).to.eql(\"John\");\r\n    pm.expect(json.surname).to.eql(\"Doe\");\r\n    pm.expect(json.patronymic).to.eql(\"Johnsonovych\");\r\n    pm.expect(json.role).to.eql(\"READER\")\r\n    pm.expect(json.isActive).to.eql(true);\r\n    pm.environment.set('createdUserId', json.id);\r\n})\r\n\r\n            \r\n"
            ]
          }
        }
